From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: thongass000 <tienthong2004@gmail.com>
Date: Sun, 4 Oct 2026 18:23:59 +0700
Subject: [PATCH 2/2] ksu: Fix missing linux/version.h header inclusions for
 LINUX_VERSION_CODE

---
 kernel/core/init.c          | 1 +
 kernel/infra/su_mount_ns.c  | 2 +-
 kernel/policy/app_profile.c | 2 +-
 3 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/kernel/core/init.c b/kernel/core/init.c
index 2359678b..9fbe149e 100644
--- a/kernel/core/init.c
+++ b/kernel/core/init.c
@@ -1,3 +1,4 @@
+#include <linux/version.h>
 #include <linux/export.h>
 #include <linux/fs.h>
 #include <linux/kobject.h>
diff --git a/kernel/infra/su_mount_ns.c b/kernel/infra/su_mount_ns.c
index cadb10b7..cac05d13 100644
--- a/kernel/infra/su_mount_ns.c
+++ b/kernel/infra/su_mount_ns.c
@@ -8,6 +8,7 @@
 #include <linux/namei.h>
 #include <linux/proc_ns.h>
 #include <linux/pid.h>
+#include <linux/version.h>
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(4, 11, 0)
 #include <linux/sched/task.h>
 #else
@@ -15,7 +16,6 @@
 #endif
 #include <linux/slab.h>
 #include <linux/syscalls.h>
-#include <linux/version.h>
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 0, 0)
 #include <uapi/linux/mount.h>
 #else
diff --git a/kernel/policy/app_profile.c b/kernel/policy/app_profile.c
index dc8cd657..6d6fcc3b 100644
--- a/kernel/policy/app_profile.c
+++ b/kernel/policy/app_profile.c
@@ -4,6 +4,7 @@
 #include <linux/capability.h>
 #include <linux/cred.h>
 #include <linux/sched.h>
+#include <linux/version.h>
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(4, 11, 0)
 #include <linux/sched/user.h>
 #include <linux/sched/signal.h>
@@ -14,7 +15,6 @@
 #include <linux/slab.h>
 #include <linux/thread_info.h>
 #include <linux/uidgid.h>
-#include <linux/version.h>
 
 #include "policy/allowlist.h"
 #include "policy/app_profile.h"
-- 
2.34.1

